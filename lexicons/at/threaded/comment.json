{
  "lexicon": 1,
  "id": "at.threaded.comment",
  "defs": {
    "main": {
      "type": "record",
      "description": "A comment on a submission, optionally replying to another comment.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "text", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The submission under discussion."
          },
          "parent": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The comment this replies to. Absent on top-level comments."
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "maxGraphemes": 5000,
            "description": "Body in CommonMark."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
