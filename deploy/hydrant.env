HYDRANT_DATABASE_PATH=/var/lib/hydrant/db
# The API is on a Unix socket only, so its management endpoints never reach
# the network. 0660 lets the hydrant group, which threaded joins, connect.
HYDRANT_API_BIND=unix:/run/hydrant/api.sock
HYDRANT_API_SOCKET_MODE=0660
# Exact NSIDs: a wildcard would also match at.threaded.dev.*. Votes are a
# signal too: hydrant drops an account holding no signal record, even one
# Threaded asked it to track, so an account that only votes needs it.
HYDRANT_FILTER_SIGNALS=at.threaded.submission,at.threaded.comment,at.threaded.vote
HYDRANT_FILTER_COLLECTIONS=at.threaded.submission,at.threaded.comment,at.threaded.vote
# hydrant's default, plc.wtf, answers with a redirect hydrant does not follow.
HYDRANT_PLC_URL=https://plc.directory
# Keeps the database off zstd; set before the database is first created.
HYDRANT_DATA_COMPRESSION=lz4
HYDRANT_CACHE_SIZE=32
RUST_LOG=info
