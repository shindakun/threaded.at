THREADED_DB=sqlite:/var/lib/threaded/threaded.db
THREADED_ADDR=127.0.0.1:8787
THREADED_PUBLIC_URL=https://threaded.at
THREADED_OAUTH_KEY=/etc/threaded/oauth-key.json
THREADED_COOKIE_KEY=/etc/threaded/cookie.key
RUST_LOG=info
# AI triage stays off until this names a file holding an Anthropic API key.
# THREADED_ANTHROPIC_KEY=/etc/threaded/anthropic.key
# The network indexer stays off until this names hydrant's API socket.
# THREADED_HYDRANT_SOCKET=/run/hydrant/api.sock
